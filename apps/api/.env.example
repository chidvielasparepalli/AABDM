# AABDM API Environment Variables
# Copy to .env and fill in values

# Database
# SQLite (dev, default): sqlite:///./aabdm.db
# PostgreSQL (prod): postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./aabdm.db

# Clerk Authentication
# Get from Clerk Dashboard > API Keys > Publishable Key
# Format: pk_live_... or pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# CORS Origins (comma-separated)
# Frontend URL(s) allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
# Requests per window per IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API
API_VERSION=0.1.0
API_TITLE=AABDM API